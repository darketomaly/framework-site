---
import SeoHead from "../../components/SeoHead.astro"
import { ClientRouter } from "astro:transitions";
import { siDiscord, siGithub, siSteam, siX } from "simple-icons";
import "@fontsource/rajdhani/400.css";
import "@fontsource/rajdhani/500.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" />
	<meta name="generator" content={Astro.generator} />
	<ClientRouter />
	<SeoHead />
</head>
<body>
	<header class="site-header">
		<div class="header-left">
			<a class="back-link" href="/" data-astro-prefetch aria-label="Return to home">← Return</a>
			<a class="logo-link" href="/" data-astro-prefetch aria-label="Darketomaly home">
				<img src="/logo.png" alt="Darketomaly logo" />
			</a>
		</div>
		<div class="header-right">
			<details class="tools-menu">
				<summary>
					<span>Tools</span>
					<span class="tools-caret" aria-hidden="true">▾</span>
				</summary>
				<div class="tools-menu-panel" role="menu" aria-label="Tools links">
					<a href="/tools/discord-bot" data-astro-prefetch>
						Discord bot <span class="external-arrow" aria-hidden="true">→</span>
					</a>
					<a href="/tools/word-generator" data-astro-prefetch>
						Word generator <span class="external-arrow" aria-hidden="true">→</span>
					</a>
				</div>
			</details>
			<nav class="social-links" aria-label="Social media links">
				<a class="social-link" href="https://x.com/darketomaly" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={siX.path} />
					</svg>
				</a>
				<a class="social-link" href="https://github.com/darketomaly" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={siGithub.path} />
					</svg>
				</a>
				<a class="social-link" href="https://steamcommunity.com/id/darketomaly" target="_blank" rel="noopener noreferrer" aria-label="Steam">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={siSteam.path} />
					</svg>
				</a>
				<a class="social-link" href="https://discord.gg/rdvjBaKu67" target="_blank" rel="noopener noreferrer" aria-label="Discord">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={siDiscord.path} />
					</svg>
				</a>
			</nav>
		</div>
	</header>

	<main class="embed-main" id="embed-main">
		<div class="tool-splash" id="tool-splash" aria-hidden="true">
			<img src="/logo.png" alt="" />
			<div class="splash-progress">
				<div class="splash-progress-bar"></div>
			</div>
		</div>
		<iframe
			id="tool-frame"
			src="https://api.darketomaly.com/generate-word"
			title="Darketomaly Word Generator"
			loading="eager"
			referrerpolicy="strict-origin-when-cross-origin"
		></iframe>
	</main>
	<script>
		const initToolSplash = () => {
			const embedMain = document.getElementById("embed-main");
			const splash = document.getElementById("tool-splash");
			const frame = document.getElementById("tool-frame");
			if (!embedMain || !splash || !frame || embedMain.dataset.splashInit === "1") return;

			embedMain.dataset.splashInit = "1";
			let revealed = false;
			let fallbackTimer = 0;
			const minSplashMs = 1000;
			const startedAt = performance.now();

			const reveal = () => {
				if (revealed) return;
				const elapsed = performance.now() - startedAt;
				if (elapsed < minSplashMs) {
					window.setTimeout(reveal, minSplashMs - elapsed);
					return;
				}
				revealed = true;
				if (fallbackTimer) {
					clearTimeout(fallbackTimer);
				}
				embedMain.classList.add("is-loaded");
				splash.addEventListener("transitionend", () => {
					splash.setAttribute("hidden", "");
				}, { once: true });
			};

			frame.addEventListener("load", () => {
				requestAnimationFrame(() => requestAnimationFrame(reveal));
			}, { once: true });

			try {
				const state = frame.contentDocument && frame.contentDocument.readyState;
				if (state === "interactive" || state === "complete") {
					requestAnimationFrame(() => requestAnimationFrame(reveal));
				}
			} catch {}

			fallbackTimer = window.setTimeout(reveal, 12000);
		};

		initToolSplash();
		document.addEventListener("astro:page-load", initToolSplash);
	</script>
</body>
</html>

<style>
	:global(html),
	:global(body) {
		width: 100%;
		height: 100%;
		margin: 0;
	}

	:global(body) {
		background: #0b0b0d;
		color: #d5d8dc;
		font-family: "Rajdhani", system-ui, -apple-system, "Segoe UI", sans-serif;
		position: relative;
		overflow: hidden;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		position: relative;
		z-index: 20;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.back-link {
		color: #9aa3ab;
		font-size: 1.05rem;
		text-decoration: none;
		padding: 0.25rem 0.5rem;
		transition: color 180ms ease, transform 180ms ease, filter 180ms ease;
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: #eef4fa;
		transform: translateY(-1px);
		filter: drop-shadow(0 0 0.7rem rgb(238 244 250 / 0.3));
	}

	.back-link:focus-visible {
		outline: 2px solid rgb(238 244 250 / 0.7);
		outline-offset: 2px;
		border-radius: 2px;
	}

	.logo-link {
		display: inline-flex;
		transition: transform 180ms ease, filter 180ms ease, opacity 180ms ease;
	}

	.logo-link img {
		display: block;
		height: 28px;
		width: auto;
	}

	.logo-link:hover,
	.logo-link:focus-visible {
		opacity: 1;
		transform: translateY(-1px);
		filter: drop-shadow(0 0 0.8rem rgb(238 244 250 / 0.26));
	}

	.logo-link:focus-visible {
		outline: 2px solid rgb(238 244 250 / 0.7);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.tools-menu {
		position: relative;
	}

	.tools-menu > summary {
		list-style: none;
		cursor: pointer;
		color: #9aa3ab;
		font-size: 1.15rem;
		display: inline-flex;
		align-items: center;
		gap: 0.32rem;
		padding: 0.25rem 0.5rem;
		user-select: none;
		transition: color 180ms ease, transform 180ms ease, filter 180ms ease;
	}

	.tools-menu > summary::-webkit-details-marker {
		display: none;
	}

	.tools-menu[open] > summary,
	.tools-menu > summary:hover,
	.tools-menu > summary:focus-visible {
		color: #eef4fa;
		transform: translateY(-1px);
		filter: drop-shadow(0 0 0.7rem rgb(238 244 250 / 0.28));
	}

	.tools-menu > summary:focus-visible {
		outline: 2px solid rgb(238 244 250 / 0.7);
		outline-offset: 2px;
		border-radius: 2px;
	}

	.tools-caret {
		font-size: 0.78em;
		opacity: 0.9;
		transform: translateY(-0.03em);
		transition: transform 180ms ease;
	}

	.tools-menu[open] .tools-caret {
		transform: rotate(180deg) translateY(0.03em);
	}

	.tools-menu-panel {
		position: absolute;
		top: calc(100% + 0.3rem);
		right: 0;
		z-index: 30;
		min-width: 12rem;
		padding: 0.35rem;
		background: rgb(13 15 18 / 0.96);
		border: 1px solid rgb(238 244 250 / 0.15);
		border-radius: 0.4rem;
		box-shadow:
			0 0.4rem 1.5rem rgb(0 0 0 / 0.45),
			0 0 1rem rgb(203 223 245 / 0.08);
		transform-origin: top right;
		animation: tools-menu-in 160ms ease-out;
	}

	.tools-menu-panel a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 0.45rem 0.5rem;
		color: #c3ccd6;
		font-size: 1rem;
		text-decoration: none;
		transition: color 180ms ease, transform 180ms ease, filter 180ms ease, background-color 180ms ease;
	}

	.tools-menu-panel a:hover,
	.tools-menu-panel a:focus-visible {
		color: #eef4fa;
		background: rgb(238 244 250 / 0.08);
		transform: translateX(1px);
		filter: drop-shadow(0 0 0.65rem rgb(238 244 250 / 0.35));
	}

	.tools-menu-panel a:focus-visible {
		outline: 2px solid rgb(238 244 250 / 0.7);
		outline-offset: 1px;
		border-radius: 2px;
	}

	.external-arrow {
		font-size: 0.95rem;
		opacity: 0.92;
		transition: transform 180ms ease;
	}

	.tools-menu-panel a:hover .external-arrow,
	.tools-menu-panel a:focus-visible .external-arrow {
		transform: translate(1px, -1px);
	}

	.social-links {
		display: flex;
		gap: 0.25rem;
	}

	.social-link {
		display: inline-flex;
		padding: 0.35rem;
		color: #9aa3ab;
		opacity: 0.82;
		transition: color 180ms ease, opacity 180ms ease, transform 180ms ease, filter 180ms ease;
	}

	.social-link:hover,
	.social-link:focus-visible {
		color: #eef4fa;
		opacity: 1;
		transform: translateY(-1px);
		filter: drop-shadow(0 0 0.8rem rgb(238 244 250 / 0.52));
	}

	.social-link:focus-visible {
		outline: 2px solid rgb(238 244 250 / 0.7);
		outline-offset: 2px;
		border-radius: 2px;
	}

	.social-link svg {
		display: block;
		width: 1.35rem;
		height: 1.35rem;
	}

	.embed-main {
		position: relative;
		z-index: 0;
		height: calc(100dvh - 68px);
		padding: 0 1rem 1rem;
		box-sizing: border-box;
	}

	.tool-splash {
		position: absolute;
		inset: 0 1rem 1rem;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		background: #0b0b0d;
		border: 1px solid rgb(238 244 250 / 0.14);
		border-radius: 0.6rem;
		opacity: 1;
		transition: opacity 420ms ease, visibility 420ms ease;
	}

	.embed-main.is-loaded .tool-splash {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.tool-splash img {
		height: 38px;
		width: auto;
		filter: drop-shadow(0 0 0.75rem rgb(238 244 250 / 0.2));
	}

	.splash-progress {
		width: min(380px, 72vw);
		height: 6px;
		border-radius: 999px;
		background: rgb(238 244 250 / 0.14);
		overflow: hidden;
	}

	.splash-progress-bar {
		height: 100%;
		width: 34%;
		border-radius: inherit;
		background: linear-gradient(90deg, rgb(176 206 240 / 0.4), rgb(234 243 252 / 0.9), rgb(176 206 240 / 0.4));
		animation: splash-progress 1.15s ease-in-out infinite;
	}

	.embed-main.is-loaded .splash-progress-bar {
		animation: none;
		width: 100%;
		transition: width 220ms ease;
	}

	iframe {
		display: block;
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		border: 1px solid rgb(238 244 250 / 0.14);
		border-radius: 0.6rem;
		background: #0b0b0d;
	}

	@keyframes splash-progress {
		0% {
			transform: translateX(-120%);
		}
		50% {
			transform: translateX(95%);
		}
		100% {
			transform: translateX(285%);
		}
	}

	@keyframes tools-menu-in {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}
</style>
