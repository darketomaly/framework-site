---
import Layout from "../layouts/Layout.astro"
---

<Layout>
	<div class="introduction">
		<img class="profile-picture" src="/darketomaly_profile_picture.png" alt="Darketomaly profile picture">
		<div>
			<h1>Darketomaly</h1>
			<p>遊戲開發人員，擁有5年專業製作同運送電子遊戲經驗。現就讀香港理工大學創新多媒體娛樂碩士。</p>
			<p>Game developer with 5 years of professional experience building and shipping video games. Currently studying MSc in Innovative Multimedia Entertainment at The Hong Kong Polytechnic University.</p>
			<a class="contact-button" href="#contact">Contact</a>
		</div>
	</div>

	<section class="portfolio-placeholder" aria-label="Portfolio"></section>

	<section id="contact" class="contact-section" aria-labelledby="contact-heading">
		<h2 id="contact-heading">Contact</h2>
		<form id="contact-form" action="https://formsubmit.co/ajax/0b05b4a17f2ea8f4e943846f55a5a13c" method="POST">
			<input type="hidden" name="_subject" value="New message from darketomaly.com">
			<input type="hidden" name="_captcha" value="true">
			<input type="hidden" name="_template" value="table">
			<input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true">

			<label for="name">Name <span>(optional)</span></label>
			<input id="name" name="name" type="text" autocomplete="name">

			<label for="email">Email address</label>
			<input id="email" name="email" type="email" autocomplete="email" required>

			<label for="message">Message</label>
			<textarea id="message" name="message" rows="6" required></textarea>

			<button type="submit">Send message</button>
			<p class="form-status" role="status" aria-live="polite"></p>
		</form>
	</section>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const status = document.querySelector<HTMLParagraphElement>(".form-status");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
		if (button) button.disabled = true;
		if (status) status.textContent = "Sending...";

		try {
			const response = await fetch(form.action, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});

			if (!response.ok) throw new Error("The contact form request failed.");

			form.reset();
			if (status) status.textContent = "Message sent. Thank you!";
		} catch (error) {
			if (status) status.textContent = "Unable to send the message. Please try again.";
			console.error(error);
		} finally {
			if (button) button.disabled = false;
		}
	});
</script>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	.introduction {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		align-items: stretch;
		align-content: center;
		gap: 1.25rem;
		width: min(90%, 40rem);
		padding-top: 7rem;
		margin: 0 auto 2rem;
	}

	.profile-picture {
		width: 10rem;
		height: auto;
		border-radius: 13px;
		object-fit: cover;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 5vw, 2.5rem);
	}

	p {
		max-width: 32rem;
		margin: 0.4rem 0 0;
		color: #b8c1c8;
		font-size: 1rem;
		line-height: 1.6;
	}

	.contact-button {
		display: inline-block;
		margin-top: 1rem;
		border: 1px solid #b8c1c8;
		border-radius: 6px;
		padding: 0.6rem 1rem;
		color: #b8c1c8;
		text-decoration: none;
	}

	.contact-button:hover,
	.contact-button:focus-visible {
		background: #b8c1c8;
		color: #101416;
	}

	.portfolio-placeholder {
		min-height: 12rem;
		width: min(90%, 40rem);
		margin: 0 auto 2rem;
	}

	.contact-section {
		width: min(90%, 32rem);
		margin: 0 auto 4rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.5rem;
	}

	form {
		display: grid;
		gap: 0.45rem;
	}

	label {
		margin-top: 0.6rem;
		color: #b8c1c8;
	}

	label span {
		opacity: 0.7;
	}

	input,
	textarea {
		box-sizing: border-box;
		width: 100%;
		border: 1px solid #38434a;
		border-radius: 6px;
		padding: 0.65rem 0.75rem;
		background: #101416;
		color: azure;
		font: inherit;
	}

	input:focus,
	textarea:focus {
		border-color: #b8c1c8;
		outline: 2px solid rgb(184 193 200 / 0.25);
		outline-offset: 1px;
	}

	textarea {
		resize: vertical;
	}

	button {
		width: fit-content;
		margin-top: 0.75rem;
		border: 1px solid #b8c1c8;
		border-radius: 6px;
		padding: 0.6rem 1rem;
		background: transparent;
		color: #b8c1c8;
		font: inherit;
		cursor: pointer;
	}

	button:hover,
	button:focus-visible {
		background: #b8c1c8;
		color: #101416;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.6;
	}

	.form-status {
		min-height: 1.6em;
		margin: 0.5rem 0 0;
		color: #b8c1c8;
	}

	[name="_honey"] {
		position: absolute;
		left: -9999px;
	}

	@media (max-width: 30rem) {
		.introduction {
			grid-template-columns: 1fr;
			align-items: stretch;
			gap: 1rem;
		}

		.profile-picture {
			justify-self: center;
			width: 8rem;
			height: 8rem;
		}
	}
</style>