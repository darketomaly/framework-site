---
import { siGithub, siSteam, siX } from "simple-icons";
---

<header class="site-header">
	<a class="social-link" href="https://github.com/darketomaly" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path fill="currentColor" d={siGithub.path} />
		</svg>
	</a>
	<a class="social-link" href="https://x.com/darketomaly" target="_blank" rel="noopener noreferrer" aria-label="X">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path fill="currentColor" d={siX.path} />
		</svg>
	</a>
	<a class="social-link" href="https://steamcommunity.com/id/darketomaly" target="_blank" rel="noopener noreferrer" aria-label="Steam">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path fill="currentColor" d={siSteam.path} />
		</svg>
	</a>
</header>

<style>
	.site-header {
		display: flex;
		gap: 0.25rem;
		position: absolute;
		top: 1rem;
		right: 1rem;
		z-index: 1;
	}

	.social-link {
		display: inline-flex;
		padding: 0.35rem;
		border-radius: 50%;
		color: #b8c1c8;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.social-link:hover,
	.social-link:focus-visible {
		background: rgb(255 255 255 / 0.12);
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	svg {
		display: block;
		width: 1.35rem;
		height: 1.35rem;
	}
</style>
