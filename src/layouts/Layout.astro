---
// src/layouts/Layout.astro
import FilmNoise from '../components/FilmNoise.astro';
import SeoHead from '../components/SeoHead.astro';
import Header from './Header.astro';

// src/layouts/Layout.astro
import '@fontsource/rajdhani';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead />
</head>
<body style="background-color:black; color: azure">
<Header />

<!-- The noise plays globally here -->
<FilmNoise />

<!-- The specific page content gets injected here -->
<main>
    <slot />
</main>

</body>
</html>

<style>
    :global(main) {
        isolation: isolate;
        position: relative;
        z-index: 1;
    }

    :global(main > :not(.portfolio-background)) {
        position: relative;
        z-index: 1;
    }

    :global(html) {
        scrollbar-color: #38434a black;
        scrollbar-width: thin;
    }

    :global(::-webkit-scrollbar) {
        width: 10px;
    }

    :global(::-webkit-scrollbar-track) {
        background: black;
    }

    :global(::-webkit-scrollbar-thumb) {
        border: 2px solid black;
        border-radius: 999px;
        background: #38434a;
    }

    :global(::-webkit-scrollbar-thumb:hover) {
        background: #b8c1c8;
    }

    body {
        font-family: 'rajdhani', sans-serif;
    }

</style>