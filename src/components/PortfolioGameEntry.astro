---
interface Role {
	title: string
	years: string
}

interface Image {
	src: string
	alt: string
}

interface Store {
	label: string
	href: string
	icon: {
		path: string
	}
}

interface Props {
	title: string
	dateRange: string
	studio: string
	description: string
	roles: Role[]
	images: Image[]
	stores: Store[]
}

const { title, dateRange, studio, description, roles, images, stores } = Astro.props
const galleryId = `gallery-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`
---

<article class="game" data-gallery={galleryId}>
	<img class="game-logo" src="/sketch.png" alt={`${title} logo placeholder`}>
	<div class="game-details">
		<h3>{title}</h3>
		<p class="game-date">{dateRange}</p>
		<p class="studio">{studio}</p>
		<ul class="roles" aria-label={`Roles on ${title}`}>
			{roles.map((role) => <li>{role.title} <span>{role.years}</span></li>)}
		</ul>
		<p>{description}</p>
		<div class="game-gallery" aria-label={`${title} screenshots`}>
			{images.map((image, index) => (
				<button class="gallery-thumbnail" type="button" data-gallery-index={index} aria-label={`Open ${image.alt}`}>
					<img src={image.src} alt={image.alt}>
				</button>
			))}
		</div>
		<nav class="store-links" aria-label={`${title} store pages`}>
			{stores.map((store) => (
				<a class="store-link" href={store.href} target="_blank" rel="noopener noreferrer" aria-label={store.label}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={store.icon.path} />
					</svg>
				</a>
			))}
		</nav>
	</div>
</article>

<dialog class="lightbox" data-lightbox={galleryId} aria-label={`${title} screenshots`}>
	<button class="lightbox-close" type="button" aria-label="Close gallery">×</button>
	<button class="lightbox-previous" type="button" aria-label="Previous image">←</button>
	<div class="lightbox-content">
		<img class="lightbox-image" src={images[0].src} alt={images[0].alt}>
	</div>
	<button class="lightbox-next" type="button" aria-label="Next image">→</button>
	<div class="lightbox-footer">
		<span class="lightbox-counter">1 / {images.length}</span>
		<div class="lightbox-dots" aria-label="Select image">
			{images.map((image, index) => (
				<button type="button" data-gallery-index={index} aria-label={`Show image ${index + 1}`}></button>
			))}
		</div>
	</div>
</dialog>

<script>
	document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
		const lightbox = gallery.nextElementSibling as HTMLDialogElement | null;
		const lightboxImage = lightbox?.querySelector<HTMLImageElement>(".lightbox-image");
		const counter = lightbox?.querySelector<HTMLElement>(".lightbox-counter");
		const galleryControls = lightbox?.querySelectorAll<HTMLButtonElement>("[data-gallery-index]");
		const thumbnails = gallery.querySelectorAll<HTMLButtonElement>(".gallery-thumbnail");
		const filmNoise = document.querySelector<HTMLCanvasElement>("#film-noise");
		const filmNoiseParent = filmNoise?.parentElement;
		let currentIndex = 0;
		let previousDocumentOverflow = "";
		let isClosing = false;

		const showImage = (index: number, direction = 0) => {
			if (!lightboxImage || !counter || !galleryControls) return;

			currentIndex = (index + thumbnails.length) % thumbnails.length;
			lightboxImage.classList.remove("slide-next", "slide-previous");
			lightboxImage.src = thumbnails[currentIndex].querySelector("img")?.src ?? "";
			lightboxImage.alt = thumbnails[currentIndex].querySelector("img")?.alt ?? "";
			counter.textContent = `${currentIndex + 1} / ${thumbnails.length}`;
			if (direction) {
				void lightboxImage.offsetWidth;
				lightboxImage.classList.add(direction > 0 ? "slide-next" : "slide-previous");
			}

			galleryControls.forEach((control) => {
				const isCurrent = Number(control.dataset.galleryIndex) === currentIndex;
				control.setAttribute("aria-current", isCurrent ? "true" : "false");
			});
		};

		thumbnails.forEach((thumbnail) => {
			thumbnail.addEventListener("click", () => {
				showImage(Number(thumbnail.dataset.galleryIndex));
				previousDocumentOverflow = document.documentElement.style.overflow;
				document.documentElement.style.overflow = "hidden";
				if (lightbox && filmNoise) lightbox.insertBefore(filmNoise, lightbox.firstChild);
				lightbox?.showModal();
				lightbox?.classList.add("is-opening");
				window.setTimeout(() => lightbox?.classList.remove("is-opening"), 520);
			});
		});

		const closeLightbox = () => {
			if (!lightbox || isClosing) return;
			isClosing = true;
			lightbox.classList.add("is-closing");
			window.setTimeout(() => lightbox.close(), 320);
		};

		lightbox?.querySelector<HTMLButtonElement>(".lightbox-close")?.addEventListener("click", closeLightbox);
		lightbox?.querySelector<HTMLButtonElement>(".lightbox-previous")?.addEventListener("click", () => showImage(currentIndex - 1, -1));
		lightbox?.querySelector<HTMLButtonElement>(".lightbox-next")?.addEventListener("click", () => showImage(currentIndex + 1, 1));

		galleryControls?.forEach((control) => {
			control.addEventListener("click", () => {
				const nextIndex = Number(control.dataset.galleryIndex);
				showImage(nextIndex, nextIndex > currentIndex ? 1 : -1);
			});
		});

		lightbox?.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") showImage(currentIndex - 1, -1);
			if (event.key === "ArrowRight") showImage(currentIndex + 1, 1);
		});

		lightbox?.addEventListener("cancel", (event) => {
			event.preventDefault();
			closeLightbox();
		});

		lightbox?.addEventListener("close", () => {
			showImage(0);
			document.documentElement.style.overflow = previousDocumentOverflow;
			lightbox.classList.remove("is-opening", "is-closing");
			isClosing = false;
			if (filmNoiseParent && filmNoise) filmNoiseParent.appendChild(filmNoise);
			gallery.querySelector<HTMLButtonElement>(".gallery-thumbnail:focus")?.blur();
		});
	});
</script>

<style>
	.game {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		align-items: stretch;
		gap: 1.25rem;
	}

	.game-logo {
		width: 10rem;
		height: 10rem;
		border-radius: 13px;
		object-fit: cover;
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
	}

	.game-date,
	.studio {
		margin-top: 0.2rem;
	}

	.game-date,
	.studio,
	p,
	.roles {
		color: #b8c1c8;
	}

	.roles {
		display: grid;
		gap: 0.15rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.roles span {
		color: #7f8a91;
	}

	p {
		max-width: 32rem;
		margin: 0.4rem 0 0;
		line-height: 1.6;
	}

	.game-gallery {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.game-gallery img {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 6px;
		object-fit: cover;
	}

	.gallery-thumbnail {
		border: 0;
		padding: 0;
		background: transparent;
		cursor: pointer;
		outline: none;
	}

	.gallery-thumbnail:focus-visible {
		outline: 2px solid #b8c1c8;
		outline-offset: 3px;
	}

	.lightbox {
		box-sizing: border-box;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-rows: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		width: 100vw;
		max-width: none;
		height: 100vh;
		max-height: none;
		margin: 0;
		overflow: hidden;
		border: 0;
		padding: 1rem;
		background: rgb(16 20 22 / 0.97);
		color: #b8c1c8;
	}

	.lightbox:not([open]) {
		display: none;
	}

	.lightbox[open] {
		display: grid;
	}

	.lightbox[open].is-opening {
		animation: lightbox-open 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.lightbox[open].is-closing {
		animation: lightbox-close 320ms cubic-bezier(0.64, 0, 0.78, 0) both;
	}

	.lightbox::backdrop {
		background: rgb(0 0 0 / 0.85);
	}

	.lightbox-content {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		min-height: 0;
		height: calc(100vh - 5rem);
		overflow: hidden;
	}

	.lightbox-image {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	.lightbox[open].is-opening .lightbox-image {
		animation: image-expand 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.lightbox-image.slide-next {
		animation: image-slide-next 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.lightbox-image.slide-previous {
		animation: image-slide-previous 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.lightbox-close,
	.lightbox-previous,
	.lightbox-next,
	.lightbox-dots button {
		border: 0;
		background: transparent;
		color: #b8c1c8;
		font: inherit;
		cursor: pointer;
		user-select: none;
	}

	.lightbox-close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		font-size: 1.75rem;
		line-height: 1;
	}

	.lightbox-previous,
	.lightbox-next {
		padding: 0.75rem;
		font-size: 2rem;
	}

	.lightbox-close:hover,
	.lightbox-close:focus-visible,
	.lightbox-previous:hover,
	.lightbox-previous:focus-visible,
	.lightbox-next:hover,
	.lightbox-next:focus-visible {
		color: azure;
	}

	.lightbox-close:focus-visible,
	.lightbox-previous:focus-visible,
	.lightbox-next:focus-visible,
	.lightbox-dots button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	.lightbox-footer {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		position: relative;
		z-index: 10000;
		opacity: 1;
	}

	.lightbox-dots {
		display: flex;
		gap: 0.4rem;
	}

	.lightbox-dots button {
		width: 0.55rem;
		height: 0.55rem;
		border: 1px solid currentColor;
		border-radius: 50%;
		padding: 0;
	}

	.lightbox-dots button[aria-current="true"] {
		background: currentColor;
	}

	@keyframes lightbox-open {
		from {
			opacity: 0;
			transform: scale(0.98);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes lightbox-close {
		from {
			opacity: 1;
			transform: scale(1);
		}
		to {
			opacity: 0;
			transform: scale(0.98);
		}
	}

	@keyframes image-expand {
		from {
			opacity: 0;
			transform: scale(0.58);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes image-slide-next {
		from {
			opacity: 0;
			transform: translateX(5rem);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes image-slide-previous {
		from {
			opacity: 0;
			transform: translateX(-5rem);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.store-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 1rem;
	}

	.store-link {
		display: inline-flex;
		padding: 0.35rem;
		border-radius: 50%;
		color: #b8c1c8;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.store-link:hover,
	.store-link:focus-visible {
		background: rgb(255 255 255 / 0.12);
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	svg {
		display: block;
		width: 1.35rem;
		height: 1.35rem;
	}

	@media (max-width: 30rem) {
		.game {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.game-logo {
			justify-self: center;
			width: 8rem;
			height: 8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lightbox[open].is-opening,
		.lightbox[open].is-closing,
		.lightbox[open].is-opening .lightbox-image,
		.lightbox-image.slide-next,
		.lightbox-image.slide-previous {
			animation: none;
		}
	}
</style>
