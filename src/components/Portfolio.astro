---
import { siPlaystation, siQuest, siSteam } from "simple-icons"
import PortfolioGameEntry from "./PortfolioGameEntry.astro"
---

<div class="portfolio-background" aria-hidden="true">
	<div class="portfolio-background-layer"></div>
	<div class="portfolio-background-layer"></div>
</div>

<section class="portfolio-section" aria-labelledby="portfolio-heading">
	<h2 id="portfolio-heading">作品集 Portfolio</h2>

	<PortfolioGameEntry
		title="Project Castaway"
		logo={{ src: "/portfolio_game_entry_logo_castaway.png", alt: "Project Castaway logo" }}
		dateRange="2023–2026"
		studio="Mardonpol Inc"
		backgroundImage="/portfolio_background_red.png"
		description={{
			cantonese: "以太平洋為場景嘅合作製作生存遊戲。",
			english: "Co-op crafting survival game set in the pacific.",
		}}
		roles={[
			{ title: "主要開發人員 Lead Developer", years: "2023–2024" },
			{ title: "技術總監 Technical Director", years: "2024–2026" },
		]}
		images={[
			{ src: "/project_castaway_building.jpg", alt: "Project castaway building" },
			{ src: "/project_castaway_raft.jpg", alt: "Project castaway raft" },
			{ src: "/project_castaway_underwater.jpg", alt: "Project castaway underwater" },
		]}
		stores={[
			{ label: "Steam", href: "https://store.steampowered.com/app/1713350/Project_Castaway/", icon: siSteam },
		]}
	/>
	
	<br>

	<PortfolioGameEntry
		title="Alvo VR"
		logo={{ src: "/portfolio_game_entry_logo_alvo.png", alt: "Alvo VR logo" }}
		dateRange="2021–2023"
		studio="OutsideIn Entertainment LLC"
		backgroundImage="/portfolio_background_green.png"
		description={{
			cantonese: "快節奏嘅 VR 軍事射擊遊戲，有合作、 PvE 同 PvP 模式。",
			english: "Fast paced VR military shooter featuring co-op, PvE, and PvP modes.",
		}}
		roles={[
			{ title: "內容開發人員 Content Developer", years: "2021–2023" },
			{ title: "主要開發人員 Lead Developer", years: "2023–2023" },
		]}
		images={[
			{ src: "/alvo_pico_presentation.png", alt: "Alvo pico presentation" },
			{ src: "/alvo_town_map.jpg", alt: "Alvo town map" },
			{ src: "/alvo_development_hardware.png", alt: "Alvo development hardware" },
		]}
		stores={[
			{ label: "Steam", href: "https://store.steampowered.com/app/2000590/Alvo_VR/", icon: siSteam },
			{ label: "PlayStation", href: "https://store.playstation.com/zh-hant-hk/product/EP5971-PPSA13360_00-0816866921226432", icon: siPlaystation },
			{ label: "Meta Quest", href: "https://www.meta.com/experiences/alvo/6937410016334124/", icon: siQuest },
			{ label: "PICO Store", href: "https://www.picoxr.com/global/games/alvo-vr" },
		]}
	/>
</section>

<script>
	const portfolioBackground = document.querySelector<HTMLElement>(".portfolio-background");
	const backgroundLayers = portfolioBackground?.querySelectorAll<HTMLElement>(".portfolio-background-layer");
	const gameEntries = document.querySelectorAll<HTMLElement>(".game");
	let activeLayer = 0;

	function showBackground(game: HTMLElement) {
		if (!portfolioBackground || !backgroundLayers?.length) return;

		const nextLayer = activeLayer === 0 ? 1 : 0;
		backgroundLayers[nextLayer].style.setProperty(
			"--portfolio-background-image",
			game.style.getPropertyValue("--game-background"),
		);
		backgroundLayers[nextLayer].classList.add("is-visible");
		backgroundLayers[activeLayer].classList.remove("is-visible");
		activeLayer = nextLayer;
	}

	function hideBackground() {
		backgroundLayers?.forEach((layer) => layer.classList.remove("is-visible"));
	}

	gameEntries.forEach((game) => {
		game.addEventListener("mouseenter", () => showBackground(game));
		game.addEventListener("portfolio-background-restore", () => showBackground(game));
		game.addEventListener("mouseleave", hideBackground);
		game.addEventListener("focusin", () => showBackground(game));
		game.addEventListener("focusout", (event) => {
			if (!game.contains(event.relatedTarget as Node | null)) hideBackground();
		});
	});
</script>

<style>
	.portfolio-background {
		position: fixed;
		z-index: 0;
		inset: 0;
		pointer-events: none;
	}

	.portfolio-background-layer {
		position: absolute;
		inset: 0;
		background-image: linear-gradient(135deg, rgb(0 0 0 / 0.94) 0%, rgb(0 0 0 / 0.82) 52%, rgb(0 0 0 / 0.2) 100%), var(--portfolio-background-image);
		background-position: center;
		background-size: cover;
		opacity: 0;
		transition: opacity 420ms ease;
	}

	.portfolio-background-layer.is-visible {
		opacity: 1;
	}

	.portfolio-section {
		position: relative;
		z-index: 1;
		width: min(92%, 48rem);
		margin: 0 auto 2rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.5rem;
	}
</style>
