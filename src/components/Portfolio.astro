---
import { siPlaystation, siQuest, siSteam } from "simple-icons"
import PortfolioGameEntry from "./PortfolioGameEntry.astro"
---

<section class="portfolio-section" aria-labelledby="portfolio-heading">
	<h2 id="portfolio-heading">Portfolio</h2>

	<PortfolioGameEntry
		title="Project Castaway"
		dateRange="2023–2026"
		studio="Mardonpol Inc"
		description="Co-op crafting survival game set in the pacific."
		roles={[
			{ title: "Lead Developer", years: "2023–2024" },
			{ title: "Technical Director", years: "2024–2026" },
		]}
		images={[
			{ src: "/sketch.png", alt: "Placeholder Game screenshot one" },
			{ src: "/sketch.png", alt: "Placeholder Game screenshot two" },
			{ src: "/sketch.png", alt: "Placeholder Game screenshot three" },
		]}
		stores={[
			{ label: "Steam", href: "https://store.steampowered.com/", icon: siSteam },
		]}
	/>

	<PortfolioGameEntry
		title="Alvo VR"
		dateRange="2021–2023"
		studio="OutsideIn Entertainment LLC"
		description="Fast paced VR military shooter with multiple game modes."
		roles={[
			{ title: "Content Developer", years: "2021–2023" },
			{ title: "Lead Developer", years: "2023–2023" },
		]}
		images={[
			{ src: "/sketch.png", alt: "Placeholder Game screenshot one" },
			{ src: "/sketch.png", alt: "Placeholder Game screenshot two" },
			{ src: "/sketch.png", alt: "Placeholder Game screenshot three" },
		]}
		stores={[
			{ label: "Steam", href: "https://store.steampowered.com/", icon: siSteam },
			{ label: "PlayStation", href: "https://www.playstation.com/", icon: siPlaystation },
			{ label: "Meta Quest", href: "https://www.meta.com/experiences/quest/", icon: siQuest },
		]}
	/>
</section>

<style>
	.portfolio-section {
		width: min(90%, 40rem);
		margin: 0 auto 2rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.5rem;
	}
</style>
