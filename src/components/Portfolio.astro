---
import { siPlaystation, siQuest, siSteam } from "simple-icons"
---

<section class="portfolio-section" aria-labelledby="portfolio-heading">
	<h2 id="portfolio-heading">Portfolio</h2>

	<article class="game">
		<img class="game-logo" src="/sketch.png" alt="Placeholder game logo">
		<div class="game-details">
			<h3>Placeholder Game</h3>
			<p class="game-date">2022–2024</p>
			<p class="studio">Studio Name</p>
			<ul class="roles" aria-label="Roles on Placeholder Game">
				<li>Gameplay Programmer <span>2022–2023</span></li>
				<li>Lead Programmer <span>2023–2024</span></li>
			</ul>
			<p>A placeholder description for the first game in the portfolio. More details will be added soon.</p>
			<div class="game-gallery" aria-label="Placeholder Game screenshots">
				<button class="gallery-thumbnail" type="button" data-gallery-index="0" aria-label="Open Placeholder Game screenshot 1">
					<img src="/sketch.png" alt="Placeholder Game screenshot one">
				</button>
				<button class="gallery-thumbnail" type="button" data-gallery-index="1" aria-label="Open Placeholder Game screenshot 2">
					<img src="/sketch.png" alt="Placeholder Game screenshot two">
				</button>
				<button class="gallery-thumbnail" type="button" data-gallery-index="2" aria-label="Open Placeholder Game screenshot 3">
					<img src="/sketch.png" alt="Placeholder Game screenshot three">
				</button>
			</div>
			<nav class="store-links" aria-label="Placeholder Game store pages">
				<a class="store-link" href="https://store.steampowered.com/" target="_blank" rel="noopener noreferrer" aria-label="Steam">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={siSteam.path} />
					</svg>
				</a>
				<a class="store-link" href="https://www.playstation.com/" target="_blank" rel="noopener noreferrer" aria-label="PlayStation">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={siPlaystation.path} />
					</svg>
				</a>
				<a class="store-link" href="https://www.meta.com/experiences/quest/" target="_blank" rel="noopener noreferrer" aria-label="Meta Quest">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d={siQuest.path} />
					</svg>
				</a>
			</nav>
		</div>
	</article>
</section>

<dialog class="lightbox" id="game-lightbox" aria-label="Placeholder Game screenshots">
	<button class="lightbox-close" type="button" aria-label="Close gallery">×</button>
	<button class="lightbox-previous" type="button" aria-label="Previous image">←</button>
	<div class="lightbox-content">
		<img class="lightbox-image" src="/sketch.png" alt="Placeholder Game screenshot one">
	</div>
	<button class="lightbox-next" type="button" aria-label="Next image">→</button>
	<div class="lightbox-footer">
		<span class="lightbox-counter">1 / 3</span>
		<div class="lightbox-dots" aria-label="Select image">
			<button type="button" data-gallery-index="0" aria-label="Show image 1"></button>
			<button type="button" data-gallery-index="1" aria-label="Show image 2"></button>
			<button type="button" data-gallery-index="2" aria-label="Show image 3"></button>
		</div>
	</div>
</dialog>

<script>
	const lightbox = document.querySelector<HTMLDialogElement>("#game-lightbox");
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>(".lightbox-image");
	const counter = lightbox?.querySelector<HTMLElement>(".lightbox-counter");
	const galleryControls = lightbox?.querySelectorAll<HTMLButtonElement>("[data-gallery-index]");
	const thumbnails = document.querySelectorAll<HTMLButtonElement>(".gallery-thumbnail");
	const filmNoise = document.querySelector<HTMLCanvasElement>("#film-noise");
	const filmNoiseParent = filmNoise?.parentElement;
	let currentIndex = 0;
	let previousDocumentOverflow = "";

	const showImage = (index: number) => {
		if (!lightboxImage || !counter || !galleryControls) return;

		currentIndex = (index + 3) % 3;
		lightboxImage.alt = `Placeholder Game screenshot ${currentIndex + 1}`;
		counter.textContent = `${currentIndex + 1} / 3`;

		galleryControls.forEach((control) => {
			const isCurrent = Number(control.dataset.galleryIndex) === currentIndex;
			control.setAttribute("aria-current", isCurrent ? "true" : "false");
		});
	};

	thumbnails.forEach((thumbnail) => {
		thumbnail.addEventListener("click", () => {
			showImage(Number(thumbnail.dataset.galleryIndex));
			previousDocumentOverflow = document.documentElement.style.overflow;
			document.documentElement.style.overflow = "hidden";
			if (lightbox && filmNoise) lightbox.insertBefore(filmNoise, lightbox.firstChild);
			lightbox?.showModal();
		});
	});

	lightbox?.querySelector<HTMLButtonElement>(".lightbox-close")?.addEventListener("click", () => lightbox.close());
	lightbox?.querySelector<HTMLButtonElement>(".lightbox-previous")?.addEventListener("click", () => showImage(currentIndex - 1));
	lightbox?.querySelector<HTMLButtonElement>(".lightbox-next")?.addEventListener("click", () => showImage(currentIndex + 1));

	galleryControls?.forEach((control) => {
		control.addEventListener("click", () => showImage(Number(control.dataset.galleryIndex)));
	});

	lightbox?.addEventListener("keydown", (event) => {
		if (event.key === "ArrowLeft") showImage(currentIndex - 1);
		if (event.key === "ArrowRight") showImage(currentIndex + 1);
	});

	lightbox?.addEventListener("close", () => {
		showImage(0);
		document.documentElement.style.overflow = previousDocumentOverflow;
		if (filmNoiseParent && filmNoise) filmNoiseParent.appendChild(filmNoise);
		document.querySelector<HTMLButtonElement>(".gallery-thumbnail:focus")?.blur();
	});
</script>

<style>
	.portfolio-section {
		width: min(90%, 40rem);
		margin: 0 auto 2rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.5rem;
	}

	.game {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		align-items: stretch;
		gap: 1.25rem;
	}

	.game-logo {
		width: 10rem;
		height: 10rem;
		border-radius: 13px;
		object-fit: cover;
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
	}

	.game-date,
	.studio {
		margin-top: 0.2rem;
	}

	.game-date {
		color: #b8c1c8;
	}

	.studio {
		color: #b8c1c8;
	}

	.roles {
		display: grid;
		gap: 0.15rem;
		margin: 0.5rem 0 0;
		padding: 0;
		color: #b8c1c8;
		list-style: none;
	}

	.roles span {
		color: #7f8a91;
	}

	p {
		max-width: 32rem;
		margin: 0.4rem 0 0;
		color: #b8c1c8;
		line-height: 1.6;
	}

	.game-gallery {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.game-gallery img {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 6px;
		object-fit: cover;
	}

	.gallery-thumbnail {
		border: 0;
		padding: 0;
		background: transparent;
		cursor: pointer;
		outline: none;
	}

	.gallery-thumbnail:focus-visible {
		outline: 2px solid #b8c1c8;
		outline-offset: 3px;
	}

	.lightbox {
		box-sizing: border-box;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-rows: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		width: 100vw;
		max-width: none;
		height: 100vh;
		max-height: none;
		margin: 0;
		overflow: hidden;
		border: 0;
		padding: 1rem;
		background: rgb(16 20 22 / 0.97);
		color: #b8c1c8;
	}

	.lightbox:not([open]) {
		display: none;
	}

	.lightbox[open] {
		display: grid;
	}

	.lightbox::backdrop {
		background: rgb(0 0 0 / 0.85);
	}

	.lightbox-content {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
	}

	.lightbox-image {
		display: block;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	.lightbox-close,
	.lightbox-previous,
	.lightbox-next,
	.lightbox-dots button {
		border: 0;
		background: transparent;
		color: #b8c1c8;
		font: inherit;
		cursor: pointer;
	}

	.lightbox-close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		font-size: 1.75rem;
		line-height: 1;
	}

	.lightbox-previous,
	.lightbox-next {
		padding: 0.75rem;
		font-size: 2rem;
	}

	.lightbox-close:hover,
	.lightbox-close:focus-visible,
	.lightbox-previous:hover,
	.lightbox-previous:focus-visible,
	.lightbox-next:hover,
	.lightbox-next:focus-visible {
		color: azure;
	}

	.lightbox-close:focus-visible,
	.lightbox-previous:focus-visible,
	.lightbox-next:focus-visible,
	.lightbox-dots button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	.lightbox-footer {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.lightbox-dots {
		display: flex;
		gap: 0.4rem;
	}

	.lightbox-dots button {
		width: 0.55rem;
		height: 0.55rem;
		border: 1px solid currentColor;
		border-radius: 50%;
		padding: 0;
	}

	.lightbox-dots button[aria-current="true"] {
		background: currentColor;
	}

	.store-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 1rem;
	}

	.store-link {
		display: inline-flex;
		padding: 0.35rem;
		border-radius: 50%;
		color: #b8c1c8;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.store-link:hover,
	.store-link:focus-visible {
		background: rgb(255 255 255 / 0.12);
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	svg {
		display: block;
		width: 1.35rem;
		height: 1.35rem;
	}

	@media (max-width: 30rem) {
		.game {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.game-logo {
			justify-self: center;
			width: 8rem;
			height: 8rem;
		}
	}
</style>
