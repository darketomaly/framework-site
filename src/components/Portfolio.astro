---
import { siPlaystation, siQuest, siSteam } from "simple-icons"
import PortfolioGameEntry from "./PortfolioGameEntry.astro"
---

<section class="portfolio-section" aria-labelledby="portfolio-heading">
	<h2 id="portfolio-heading">Portfolio</h2>

	<PortfolioGameEntry
		title="Placeholder Game"
		dateRange="2022–2024"
		studio="Studio Name"
		description="A placeholder description for the first game in the portfolio. More details will be added soon."
		roles={[
			{ title: "Gameplay Programmer", years: "2022–2023" },
			{ title: "Lead Programmer", years: "2023–2024" },
		]}
		images={[
			{ src: "/sketch.png", alt: "Placeholder Game screenshot one" },
			{ src: "/sketch.png", alt: "Placeholder Game screenshot two" },
			{ src: "/sketch.png", alt: "Placeholder Game screenshot three" },
		]}
		stores={[
			{ label: "Steam", href: "https://store.steampowered.com/", icon: siSteam },
			{ label: "PlayStation", href: "https://www.playstation.com/", icon: siPlaystation },
			{ label: "Meta Quest", href: "https://www.meta.com/experiences/quest/", icon: siQuest },
		]}
	/>
</section>

<style>
	.portfolio-section {
		width: min(90%, 40rem);
		margin: 0 auto 2rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.5rem;
	}
</style>
